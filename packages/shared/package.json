{
  "name": "@sol2near/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared constants and TypeScript interfaces (lead <-> crosschain contract). Changes require agreement of both developers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
